<?xml version="1.0" encoding="utf-8"?>
<!-- the sync key is the whole account — there is no email or password to recover
     it with — so losing it on reinstall means losing the link to your other
     devices. only the datastore is included, which is where the key and the
     settings live; everything else, the catalogue cache included, is left out by
     that alone and the app refetches it on its own. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>

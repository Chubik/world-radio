<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="8dp" android:paddingBottom="16dp">

    <LinearLayout android:id="@+id/stage" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.35" android:orientation="vertical" android:gravity="center"
        android:background="@drawable/bg_stage" android:clickable="true" android:focusable="true"
        android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="20dp" android:paddingBottom="20dp">

        <FrameLayout android:id="@+id/hero_ring" android:layout_width="168dp" android:layout_height="168dp"
            android:background="@drawable/bg_hero_ring">

            <ImageView android:id="@+id/hero_glyph" android:layout_width="108dp" android:layout_height="108dp"
                android:layout_gravity="center" android:src="@drawable/ic_shuffle"
                android:tint="@color/amber_hi" android:contentDescription="@null" />
        </FrameLayout>

        <TextView android:id="@+id/hero_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/home_shuffle_label"
            android:textColor="@color/amber_hi" android:textSize="14sp" android:fontFamily="@font/ibm_plex_mono"
            android:textStyle="bold" android:letterSpacing="0.14" android:gravity="center" />

        <TextView android:id="@+id/hero_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/home_shuffle_sub_all"
            android:textColor="@color/dim" android:textSize="10.5sp" android:fontFamily="@font/ibm_plex_mono"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">

        <LinearLayout android:id="@+id/now_playing" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_stage"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="14dp" android:paddingBottom="14dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">

                <TextView android:id="@+id/kicker_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/home_now_playing" android:textColor="@color/dim" android:textSize="10sp"
                    android:fontFamily="@font/ibm_plex_mono" android:letterSpacing="0.22" />

                <LinearLayout android:id="@+id/eq" android:layout_width="wrap_content" android:layout_height="14dp"
                    android:layout_marginStart="10dp" android:orientation="horizontal" android:gravity="bottom">

                    <View android:layout_width="2.5dp" android:layout_height="6dp" android:background="@color/amber" />
                    <View android:layout_width="2.5dp" android:layout_height="12dp" android:layout_marginStart="3dp" android:background="@color/amber" />
                    <View android:layout_width="2.5dp" android:layout_height="9dp" android:layout_marginStart="3dp" android:background="@color/amber" />
                    <View android:layout_width="2.5dp" android:layout_height="14dp" android:layout_marginStart="3dp" android:background="@color/amber" />
                </LinearLayout>

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <TextView android:id="@+id/kicker_live" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/home_live" android:textColor="@color/olive" android:textSize="10sp"
                    android:fontFamily="@font/ibm_plex_mono" android:letterSpacing="0.22" />
            </LinearLayout>

            <TextView android:id="@+id/station_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="—"
                android:textColor="@color/bright" android:textSize="26sp" android:fontFamily="@font/ibm_plex_mono"
                android:textStyle="bold" android:letterSpacing="-0.01" android:lineSpacingMultiplier="1.05"
                android:maxLines="1" android:ellipsize="end" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">

                    <TextView android:id="@+id/ctx_country" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="" android:textColor="@color/mute" android:textSize="11sp"
                        android:fontFamily="@font/ibm_plex_mono" android:maxLines="1" android:ellipsize="end" />

                    <TextView android:id="@+id/ctx_codec" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:text="" android:textColor="@color/mute" android:textSize="11sp"
                        android:fontFamily="@font/ibm_plex_mono" android:maxLines="1" android:ellipsize="end" />

                    <TextView android:id="@+id/ctx_fav" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/home_fav_no" android:textColor="@color/mute" android:textSize="11sp"
                        android:fontFamily="@font/ibm_plex_mono" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                    <TextView android:id="@+id/hidden_pill" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp" android:visibility="gone" android:textColor="@color/amber_hi" android:textSize="9.5sp"
                        android:fontFamily="@font/ibm_plex_mono" android:letterSpacing="0.1"
                        android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:background="@drawable/bg_pill_on" />

                    <TextView android:id="@+id/scope_pill" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/home_scope_all" android:textColor="@color/dim" android:textSize="9.5sp"
                        android:fontFamily="@font/ibm_plex_mono" android:letterSpacing="0.1"
                        android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:background="@drawable/bg_pill" />

                    <!-- must exist in both layouts: landscape is the car-mount orientation,
                         which is exactly where a screen that blanks is the problem. -->
                    <TextView android:id="@+id/awake_pill" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:text="@string/home_awake_off"
                        android:contentDescription="@string/home_awake_desc"
                        android:textColor="@color/dim" android:textSize="9.5sp"
                        android:fontFamily="@font/ibm_plex_mono" android:letterSpacing="0.1"
                        android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:background="@drawable/bg_pill" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:columnCount="2" android:rowCount="2"
            android:useDefaultMargins="false">

            <LinearLayout android:id="@+id/btn_play" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_row="0" android:layout_column="0"
                android:layout_gravity="fill_horizontal"
                android:minHeight="66dp" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_sec_btn" android:clickable="true" android:focusable="true"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="12dp" android:paddingBottom="9dp">

                <ImageView android:id="@+id/btn_play_ico" android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_play" android:tint="@color/bright" android:contentDescription="@null" />

                <TextView android:id="@+id/btn_play_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/home_play"
                    android:textColor="@color/bright" android:textSize="10sp" android:fontFamily="@font/ibm_plex_mono"
                    android:fontWeight="600" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btn_star" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_row="0" android:layout_column="1"
                android:layout_gravity="fill_horizontal" android:layout_marginStart="10dp"
                android:minHeight="66dp" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_sec_btn" android:clickable="true" android:focusable="true"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="12dp" android:paddingBottom="9dp">

                <ImageView android:id="@+id/btn_star_ico" android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_star_outline" android:tint="@color/bright" android:contentDescription="@null" />

                <TextView android:id="@+id/btn_star_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/home_star"
                    android:textColor="@color/bright" android:textSize="10sp" android:fontFamily="@font/ibm_plex_mono"
                    android:fontWeight="600" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btn_scope" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_row="1" android:layout_column="0"
                android:layout_gravity="fill_horizontal" android:layout_marginTop="10dp"
                android:minHeight="66dp" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_sec_btn" android:clickable="true" android:focusable="true"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="12dp" android:paddingBottom="9dp">

                <ImageView android:id="@+id/btn_scope_ico" android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_scope_all" android:tint="@color/bright" android:contentDescription="@null" />

                <TextView android:id="@+id/btn_scope_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/home_scope"
                    android:textColor="@color/bright" android:textSize="10sp" android:fontFamily="@font/ibm_plex_mono"
                    android:fontWeight="600" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btn_stop" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_row="1" android:layout_column="1"
                android:layout_gravity="fill_horizontal" android:layout_marginStart="10dp" android:layout_marginTop="10dp"
                android:minHeight="66dp" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_sec_btn" android:clickable="true" android:focusable="true"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="12dp" android:paddingBottom="9dp">

                <ImageView android:id="@+id/btn_stop_ico" android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_stop" android:tint="@color/danger" android:contentDescription="@null" />

                <TextView android:id="@+id/btn_stop_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/home_stop"
                    android:textColor="@color/danger" android:textSize="10sp" android:fontFamily="@font/ibm_plex_mono"
                    android:fontWeight="600" />
            </LinearLayout>
        </GridLayout>

        <LinearLayout android:id="@+id/btn_sync" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/bg_sync_bar" android:clickable="true" android:focusable="true"
            android:paddingStart="16dp" android:paddingEnd="16dp">

            <ImageView android:id="@+id/btn_sync_ico" android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_sync" android:tint="@color/amber" android:contentDescription="@null" />

            <TextView android:id="@+id/btn_sync_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="@string/home_sync"
                android:textColor="@color/amber" android:textSize="15sp" android:fontFamily="@font/ibm_plex_mono"
                android:textStyle="bold" android:letterSpacing="0.16" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView android:id="@+id/btn_sync_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/home_sync_sub" android:textColor="@color/dim" android:textSize="10.5sp"
                android:fontFamily="@font/ibm_plex_mono" android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
